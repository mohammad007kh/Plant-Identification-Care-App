# ============================================================================
# Plant Identification & Care — environment template
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.
# Every variable consumed by docker-compose.yml and the apps is documented here.
# ============================================================================

# --- Runtime ---
# Ports use an uncommon 1xxxx block so this project runs alongside other local
# projects without conflicts. Backend API listens on PORT; CORS_ORIGIN is the
# frontend origin allowed to send credentialed requests.
NODE_ENV=development
PORT=13001
CORS_ORIGIN=http://localhost:13000

# --- PostgreSQL (docker-compose: postgres, host 15432 → container 5432) ---
POSTGRES_USER=plant
POSTGRES_PASSWORD=changeme-in-.env
POSTGRES_DB=plant
DATABASE_URL=postgres://plant:changeme-in-.env@localhost:15432/plant

# --- Redis (docker-compose: redis, host 16379; cache + BullMQ) ---
REDIS_URL=redis://localhost:16379

# --- MinIO / S3-compatible object storage (docker-compose: minio, host 19000/19001) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-in-.env
MINIO_ENDPOINT=http://localhost:19000
MINIO_BUCKET=plant-photos
# Upload caps (bytes + decoded pixels) — decompression-bomb defense
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_PIXELS=24000000

# --- SMTP (docker-compose: mailpit in dev, host 11025 SMTP / 18025 web UI; Iranian relay in prod) ---
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=no-reply@plantcare.local

# --- Web push (care reminders, best-effort/secondary channel — FR-020) ---
# Generate a dev pair with `npx web-push generate-vapid-keys`. Unset in an
# environment = push is silently skipped (email remains the guaranteed path).
VAPID_PUBLIC_KEY=changeme-in-.env
VAPID_PRIVATE_KEY=changeme-in-.env
VAPID_SUBJECT=mailto:support@plantcare.local
# How often the reminder sweep re-scans plants for a due watering reminder.
REMINDER_SWEEP_EVERY_MS=900000

# --- Auth (JWT: short-lived access + rotating refresh) ---
JWT_ACCESS_SECRET=changeme-in-.env
JWT_REFRESH_SECRET=changeme-in-.env
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- AI provider (OpenAI via LangChain/LangGraph) ---
OPENAI_API_KEY=sk-changeme-in-.env
AI_CONFIDENCE_THRESHOLD=0.70
AI_MAX_ATTEMPTS=2
# Credit reconciliation: refund usage records stuck 'pending' past this timeout
RECONCILE_TIMEOUT_MS=300000
RECONCILE_EVERY_MS=60000

# --- Payments (mock Zarinpal for v1) ---
PAYMENT_PROVIDER=zarinpal_mock

# --- Frontend (Next.js) ---
# Base URL the browser calls the NestJS API at (global prefix `/v1` is part
# of each request path, not this value). `frontend/src/lib/api/index.ts` and
# every per-feature `*-api.ts` module read this via
# `process.env.NEXT_PUBLIC_API_BASE_URL ?? ''` — unset/empty means same-origin
# (e.g. behind a reverse proxy in prod); in local dev the backend runs on a
# different port, so this must be set explicitly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:13001
